# server/.env.example - Environment configuration template

# Environment
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# SSL Configuration (for production)
SSL_ENABLED=false
SSL_KEY_PATH=/path/to/private-key.pem
SSL_CERT_PATH=/path/to/certificate.pem

# CORS Settings
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# WebSocket Configuration
WS_PING_INTERVAL=30000
WS_PING_TIMEOUT=5000
WS_MAX_CONNECTIONS=1000
MAX_FEEDS_PER_SENDER=5

# Redis Configuration (for scaling)
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# Database Configuration (optional)
DATABASE_ENABLED=false
DATABASE_URL=postgresql://user:password@localhost:5432/videostreaming
DB_POOL_MIN=2
DB_POOL_MAX=10

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_S3_BUCKET=video-streaming-recordings
AWS_S3_RECORDINGS_PREFIX=recordings/

# CloudWatch Monitoring
CLOUDWATCH_ENABLED=false
CLOUDWATCH_NAMESPACE=VideoStreaming

# Authentication
AUTH_ENABLED=false
JWT_SECRET=change_this_secret_in_production_to_a_long_random_string
JWT_EXPIRY=24h
API_KEYS=key1,key2,key3

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
LOG_DIRECTORY=./logs
LOG_MAX_FILES=14
LOG_MAX_SIZE=20m

# TURN/STUN Servers for WebRTC
STUN_SERVER=stun:stun.l.google.com:19302
TURN_SERVER=turn:your-turn-server.com:3478
TURN_USERNAME=username
TURN_PASSWORD=password

# Static Files
SERVE_STATIC=false

# Monitoring
HEALTH_CHECK_INTERVAL=30000
METRICS_ENABLED=false
METRICS_PORT=9090